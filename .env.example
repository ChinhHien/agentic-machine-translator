[TEMPLATE]
# ============================================================================
# Cấu hình môi trường polyglot-lc
# Sao chép sang .env và điền giá trị. Mỗi agent có thể dùng một nhà cung cấp
# KHÁC nhau (OpenAI, DeepSeek, Anthropic qua proxy tương thích OpenAI, Ollama,
# vLLM...).
#
# Đây là BẢN MẪU. Tất cả API_KEY đều là giá trị ví dụ "sk-..." — hãy thay
# bằng key thật của bạn trong file .env (KHÔNG commit key thật).
# Cách dùng: sao chép file này thành .env, điền key, rồi chạy pipeline.
# ============================================================================

# ----------------------------- Agent Planner ---------------------------------
# Planner chạy MỘT LẦN ở đầu pipeline (chiến lược cấp tài liệu) và độc lập
# với nhóm đọc-nguồn (read-source).
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini
PLANNER_API_KEY=sk-...
PLANNER_TEMPERATURE=0.2

# ============================================================================
# NHÓM ĐỌC-NGUỒN (READ-SOURCE) - Kiến trúc lai
# ----------------------------------------------------------------------------
# Translator, Critic và Refiner đều đọc lại CÙNG một chunk nguồn ban đầu và
# đối chiếu nó với plan/draft/critique. Giữ chúng trên MỘT nhà cung cấp/model
# giúp bộ nhớ đệm prompt/context gốc của nhà cung cấp phục vụ được cùng một
# tiền tố ổn định dùng chung (văn bản gốc + glossary + strategy).
# Đặt nhóm một lần tại đây; bất kỳ giá trị riêng TRANSLATOR_*/CRITIC_*/REFINER_*
# nào vẫn ghi đè lên nó. Verifier giữ độc lập.
SOURCE_GROUP_BASE_URL=https://api.openai.com/v1
SOURCE_GROUP_MODEL=gpt-4o
SOURCE_GROUP_API_KEY=sk-...
SOURCE_GROUP_TEMPERATURE=0.3

# ---------------------------- Agent Translator --------------------------------
# Ghi đè tùy chọn theo từng agent so với nhóm đọc-nguồn.
#TRANSLATOR_BASE_URL=https://api.openai.com/v1
#TRANSLATOR_MODEL=gpt-4o
#TRANSLATOR_API_KEY=sk-...
#TRANSLATOR_TEMPERATURE=0.3

# ------------------------------ Agent Critic -----------------------------------
#CRITIC_BASE_URL=https://api.deepseek.com/v1
#CRITIC_MODEL=deepseek-chat
#CRITIC_API_KEY=sk-...
#CRITIC_TEMPERATURE=0.1

# ------------------------------ Agent Refiner ----------------------------------
#REFINER_BASE_URL=http://localhost:11434/v1
#REFINER_MODEL=qwen2.5:14b
#REFINER_API_KEY=ollama
#REFINER_TEMPERATURE=0.4

# ------------------------------ Agent Verifier --------------------------------
# Nhóm độc lập: chỉ đọc bản dịch cuối + các tiêu chí.
VERIFIER_BASE_URL=https://openai-proxy.anthropic.com/v1
VERIFIER_MODEL=claude-3-5-sonnet-20241022
VERIFIER_API_KEY=sk-ant-...
VERIFIER_TEMPERATURE=0.0

# --------------------------- Embedding (Reasoning Bank) -----------------------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-...

# ----------------------------- Cài đặt chung ----------------------------------
REASONING_BANK_PATH=./data/reasoning_bank
SKILLS_DIR=./skills
LOGS_DIR=./logs
LOG_JSONL=1
LLM_MOCK=0

# ---------- LLM resilience (lỗi hạ tầng / cơ sở hạ tầng) ----------------------
# Số lần thử lại có giới hạn chỉ dành cho lỗi truyền tải/nhà cung cấp
# (429, 408, timeout, 500/502/503/504, lỗi kết nối). Lỗi ngữ nghĩa
# (Verifier FAIL) dùng một nhánh dịch lại riêng, có giới hạn và không bao giờ
# trộn lẫn với các lỗi trên.
# LLM_MAX_RETRIES là trần số lần thử lại hạ tầng (còn gọi là MAX_INFRA_RETRIES).
LLM_MAX_RETRIES=3
# Timeout mặc định cho MỘT request LLM (giây). Áp dụng cho mọi agent/embedding
# KHÔNG đặt <NAME>_TIMEOUT / EMBED_TIMEOUT riêng. Nên để mức vừa phải (30-60s)
# để một endpoint bị treo không làm tắc cả pipeline hàng phút.
LLM_TIMEOUT=45
# Backoff lũy thừa (dùng khi nhà cung cấp không đưa gợi ý thử lại): 2s, 4s, 8s...
LLM_RETRY_BASE_DELAY=2
LLM_RETRY_MAX_DELAY=60
# Cộng thêm lên trên gợi ý của nhà cung cấp ("thử lại sau 47.4s" -> chờ 47.4s + 2s).
LLM_RETRY_BUFFER_SECONDS=2
# Phần nhiễu (jitter) giới hạn trong [0,1] áp dụng cho backoff lũy thừa (tránh
# hiện tượng thử lại đồng loạt); gợi ý Retry-After của nhà cung cấp dùng nguyên vẹn.
LLM_RETRY_JITTER=0.2

# ---------- Debug / Logging ---------------------------------------------------
# Set to 1 to enable verbose LLM client logging (request/response timing, tokens)
LLM_VERBOSE=0
# Set to 1 to enable verbose resilience logging (retry details, fallback decisions)
LLM_VERBOSE_RESILIENCE=0

# ------------------------- Endpoint dự phòng (fallback) -----------------------
# Endpoint dự phòng tùy chọn theo từng agent. Chỉ dùng sau khi hết số lần thử
# lại trên endpoint chính (giới hạn tốc độ, timeout, lỗi kết nối). Yêu cầu CẢ HAI biến.
# TRANSLATOR_BACKUP_BASE_URL=https://api.deepseek.com/v1
# TRANSLATOR_BACKUP_MODEL=deepseek-chat
# TRANSLATOR_BACKUP_API_KEY=sk-...

# Giá trị mặc định cho dịch thuật
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
CRITIC_THRESHOLD=7.0
REFINE_ROUNDS=2
RB_TOP_K=4

# Độ đồng thời có giới hạn giữa các chunk độc lập (mỗi chunk giữ nguyên thứ tự
# nội bộ Translate -> Critic -> Refiner -> Verify). Mặc định thận trọng là 2.
# Planner/summary/assemble giữ tuần tự. Đặt 1 để chạy hoàn toàn tuần tự.
MAX_CONCURRENCY=2

# Cổng Refiner thích ứng: một draft có điểm >= mức này sẽ bỏ qua Refiner và đi
# thẳng tới Verifier. Mặc định là CRITIC_THRESHOLD (không đổi hành vi); hãy
# nâng lên để bỏ qua refiner trong khoảng "chấp nhận được nhưng dưới ngưỡng".
REFINE_MIN_SCORE=7.0

# Per-agent timeout override (seconds). Chosen per-agent <NAME>_TIMEOUT wins
# over the global LLM_TIMEOUT. Useful for slow/flaky providers.
# Example: VERIFIER_TIMEOUT=30
#VERIFIER_TIMEOUT=30
# Embedding timeout override (seconds); else falls back to LLM_TIMEOUT.
#EMBED_TIMEOUT=30

# ------------- Bộ nhớ đệm Prompt / context -----------------------------------
# auto (mặc định): sắp xếp yêu cầu theo thứ tự tiền tố-ổn định-trước để nhà
#   cung cấp tự động lưu vào bộ nhớ đệm context nguồn dùng chung; đọc số liệu
#   sử dụng cache khi API báo cáo (OpenAI prompt_tokens_details.cached_tokens,
#   DeepSeek prompt_cache_hit_tokens, Anthropic cache_read_input_tokens).
# explicit: gửi thêm một điểm đánh dấu cache_control kiểu Anthropic sau tiền tố
#   ổn định (cho các gateway yêu cầu cache markers tường minh).
# off: không gửi marker nào (số liệu sử dụng vẫn được ghi khi được cung cấp).
PROMPT_CACHE=auto

# Khi 0 (mặc định) summary tree bỏ qua các lệnh gọi Planner LLM theo từng chunk
# (những bản tóm tắt theo từng chunk đó không được dùng ở phía sau). Đặt 1 để
# khôi phục. Chỉ dùng trên nhánh planning cũ (UNIFIED_PLANNER=0).
SUMMARY_TREE_CHUNK_SUMMARIES=0

# MỘT yêu cầu Planner tạo ra tóm tắt tài liệu, strategy, glossary (kèm các
# thuật ngữ ngôn ngữ đích), độ phức tạp tài liệu và ghi chú từng phần. Đặt 0
# để quay lại luồng summary-tree-rồi-plan cũ (một yêu cầu mỗi phần).
UNIFIED_PLANNER=1

# Pipeline chất lượng thích ứng. Một chunk có cấu trúc đơn giản VÀ có draft
# vượt qua các kiểm tra tất định VÀ có điểm >= FAST_PATH_MIN_SCORE sẽ đi thẳng
# tới Verifier, bỏ qua Critic và Refiner. Việc định tuyến là cục bộ, nên nó
# không tốn thêm token nào. Đặt ADAPTIVE_QUALITY=0 để dùng đường đầy đủ đồng nhất.
ADAPTIVE_QUALITY=1

# Cổng fast-path, phần 1: độ phức tạp chunk 0..1 (cấu trúc, độ dài, mã
# placeholder, mật độ thuật ngữ, ghi chú phần của planner).
FAST_PATH_MAX_COMPLEXITY=0.35
# Cổng fast-path, phần 2: chất lượng draft tất định 0..10 (kiểm tra cứng,
# dải độ dài, rò rỉ nguồn chưa dịch).
FAST_PATH_MIN_SCORE=9.0

# 1 cũng bỏ qua Verifier LLM trả phí trên các chunk fast-path: các kiểm tra
# cứng tất định đã qua, nên phán quyết sẽ chẳng thêm gì. Mặc định tắt vì nó
# loại bỏ cổng ngữ nghĩa cuối cùng cho những chunk đó.
FAST_PATH_SKIP_LLM_VERIFY=0

# Checkpoint theo từng chunk (<dir>/<job>/<chunk>.json) được ghi khi chunk
# hoàn thành, để một lần chạy bị gián đoạn có thể tiếp tục. Đặt "off" để tắt hoàn toàn.
CHECKPOINT_DIR=./data/checkpoints

# 1 tái sử dụng checkpoint từ lần chạy bị gián đoạn (còn: CLI --resume). Một
# lần tiếp tục hoàn toàn tốn 0 yêu cầu. Checkpoint tự động bị vô hiệu khi tài
# liệu, cặp ngôn ngữ, domain, model hoặc cách chia chunk thay đổi.
RESUME=0

# 1 ghi lại file đầu ra khi các chunk hoàn thành, đánh dấu phần còn lại là
# pending (hữu ích cho các lần chạy dài; quá trình hợp nhất cuối cùng luôn ghi đè nó).
PARTIAL_OUTPUT=0

# ------------------------------ Đầu ra ----------------------------------------
# md   (mặc định): bản dịch Markdown như trước (bảng/code/tiêu đề đều được dịch).
# pdf           : dựng lại chính PDF gốc với chữ đã dịch, giữ nguyên khổ trang,
#                 ảnh, đồ hoạ vector và đường kẻ bảng; nhúng font Unicode và tự
#                 thu nhỏ cỡ chữ cho vừa khung. Bảng và code giữ nguyên bản gốc.
# both          : ghi cả hai, cùng một đường dẫn gốc (--out / -o).
OUTPUT_FORMAT=md

# Font .ttf dùng để in bản dịch vào PDF; phải có dấu tiếng Việt. Để trống thì
# chương trình tự dò Times New Roman / Arial / Segoe UI / DejaVu… và báo lỗi rõ
# ràng nếu không tìm thấy.
#PDF_FONT_PATH=C:/Windows/Fonts/times.ttf

# Bước kiểm tra nhất quán thuật ngữ giữa các chunk: các chunk đi lệch khỏi
# glossary đã lên kế hoạch sẽ được vá lại thay vì dịch lại.
CONSISTENCY_CHECK=1
# Giới hạn trên của số yêu cầu vá mỗi tài liệu (0 tắt việc vá).
CONSISTENCY_MAX_PATCHES=5