# Bản mẫu cấu hình polyglot-lc. Sao chép thành .env rồi điền giá trị.
# .env đã nằm trong .gitignore — KHÔNG commit khoá thật.
#
# Phần BẮT BUỘC ở trên: bốn nhóm endpoint.
# Phần TÙY CHỌN ở dưới: mọi biến tinh chỉnh đã bị comment sẵn kèm giá trị
# mặc định của mã. Bỏ comment dòng nào là đổi đúng biến đó; không bỏ comment
# thì mã dùng mặc định, nên mặc định thay đổi trong mã vẫn tới được bạn.
#
# Giải thích từng biến và khi nào nên đổi: docs/configuration.md

# --- Planner ------------------------------------------------------------------
# Chạy MỘT LẦN ở đầu pipeline: chiến lược, thuật ngữ, ghi chú từng phần.
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini
PLANNER_API_KEY=sk-...

# --- Nhóm đọc-nguồn (Translator · Critic · Refiner) ---------------------------
# Dùng CHUNG một provider/model để bộ nhớ đệm tiền tố của provider phục vụ
# được cả ba. Giá trị riêng TRANSLATOR_*/CRITIC_*/REFINER_* vẫn thắng nếu đặt.
SOURCE_GROUP_BASE_URL=https://api.openai.com/v1
SOURCE_GROUP_MODEL=gpt-4o
SOURCE_GROUP_API_KEY=sk-...

# --- Verifier -----------------------------------------------------------------
# Độc lập với nhóm trên: chỉ đọc bản dịch cuối và các tiêu chí.
VERIFIER_BASE_URL=https://api.openai.com/v1
VERIFIER_MODEL=gpt-4o-mini
VERIFIER_API_KEY=sk-...

# --- Embedding (Reasoning Bank) -----------------------------------------------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-...

# ==============================================================================
# TÙY CHỌN — mỗi dòng là một biến kèm mặc định của mã. Bỏ comment để đổi.
# ==============================================================================

# --- Thư mục & đầu ra ---------------------------------------------------------
#REASONING_BANK_PATH=./data/reasoning_bank
#SKILLS_DIR=./skills
#LOGS_DIR=./logs
#CHECKPOINT_DIR=./data/checkpoints
#OUTPUT_FORMAT=md
#PARTIAL_OUTPUT=0
#RESUME=0
#PDF_FONT_PATH=

# --- Logging / chạy thử -------------------------------------------------------
#LOG_JSONL=1
#LLM_VERBOSE=0
#LLM_VERBOSE_RESILIENCE=0
#LLM_MOCK=0

# --- Chia đoạn & song song ----------------------------------------------------
#CHUNK_MAX_TOKENS=700
#CHUNK_OVERLAP_TOKENS=80
#MAX_CONCURRENCY=1

# --- Chất lượng ---------------------------------------------------------------
#CRITIC_THRESHOLD=7.0
#REFINE_ROUNDS=2
#REFINE_MIN_SCORE=7.0
#RB_TOP_K=4

# --- Đường tắt thích ứng ------------------------------------------------------
#ADAPTIVE_QUALITY=1
#FAST_PATH_MAX_COMPLEXITY=0.35
#FAST_PATH_MIN_SCORE=9.0
#FAST_PATH_SKIP_LLM_VERIFY=0

# --- Nhất quán thuật ngữ xuyên chunk ------------------------------------------
#CONSISTENCY_CHECK=1
# Ngân sách vá thực tế = max(giá trị dưới, 30% số chunk lệch); 0 là tắt vá.
#CONSISTENCY_MAX_PATCHES=5

# --- Retry & timeout ----------------------------------------------------------
#LLM_MAX_RETRIES=3
#LLM_TIMEOUT=45
#LLM_RETRY_BASE_DELAY=2
#LLM_RETRY_MAX_DELAY=60
#LLM_RETRY_BUFFER_SECONDS=2
#LLM_RETRY_JITTER=0.2
#LLM_PROVIDER_CONCURRENCY=1
#LLM_RETRY_CONCURRENCY_WAIT=10
#LLM_RETRY_SLOT_REBUILD_AFTER=3

# --- Chờ rồi chạy lại một chunk -----------------------------------------------
#CHUNK_RETRY_BASE_DELAY=5
#CHUNK_RETRY_MAX_DELAY=120

# --- Prompt cache -------------------------------------------------------------
# auto|explicit|off (mặc định: auto; xem docs/configuration.md)
#PROMPT_CACHE=off

# --- Nhiệt độ & timeout theo nhóm/agent ---------------------------------------
#SOURCE_GROUP_TEMPERATURE=0.3
#EMBED_TIMEOUT=45
# Ghi đè theo từng agent: cùng bộ biến, đổi tiền tố sang TRANSLATOR_,
# CRITIC_, REFINER_, PLANNER_, VERIFIER_ (ví dụ CRITIC_MODEL=deepseek-chat).
#TRANSLATOR_BASE_URL=https://api.openai.com/v1
#TRANSLATOR_MODEL=gpt-4o
#TRANSLATOR_API_KEY=sk-...
#TRANSLATOR_TEMPERATURE=0.3
#TRANSLATOR_TIMEOUT=45

# Endpoint dự phòng, chỉ dùng sau khi endpoint chính hết lượt thử lại.
#LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
#LLM_BACKUP_MODEL=deepseek-chat
#LLM_BACKUP_API_KEY=sk-...
