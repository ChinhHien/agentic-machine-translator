# polyglot-lc — bản mẫu .env
# Điền bốn nhóm endpoint bên dưới; phần còn lại để comment thì mã dùng mặc định.
# Giải thích từng biến và khi nào nên đổi: docs/configuration.md

# --- Planner ---
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini
PLANNER_API_KEY=sk-...

# --- Nhóm đọc-nguồn: Translator · Critic · Refiner ---
SOURCE_GROUP_BASE_URL=https://api.openai.com/v1
SOURCE_GROUP_MODEL=gpt-4o
SOURCE_GROUP_API_KEY=sk-...

# --- Verifier ---
VERIFIER_BASE_URL=https://api.openai.com/v1
VERIFIER_MODEL=gpt-4o-mini
VERIFIER_API_KEY=sk-...

# --- Embedding (Reasoning Bank) ---
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-...

# --- Ghi đè theo từng agent ---
#PLANNER_TEMPERATURE=0.3
#PLANNER_TIMEOUT=300
#TRANSLATOR_BASE_URL=https://api.openai.com/v1
#TRANSLATOR_MODEL=gpt-4o
#TRANSLATOR_API_KEY=sk-...
#TRANSLATOR_TEMPERATURE=0.3
#TRANSLATOR_TIMEOUT=300
#CRITIC_BASE_URL=https://api.openai.com/v1
#CRITIC_MODEL=gpt-4o
#CRITIC_API_KEY=sk-...
#CRITIC_TEMPERATURE=0.3
#CRITIC_TIMEOUT=300
#REFINER_BASE_URL=https://api.openai.com/v1
#REFINER_MODEL=gpt-4o
#REFINER_API_KEY=sk-...
#REFINER_TEMPERATURE=0.3
#REFINER_TIMEOUT=300
#VERIFIER_TEMPERATURE=0.0
#VERIFIER_TIMEOUT=300
#SOURCE_GROUP_TEMPERATURE=0.3

# --- Endpoint dự phòng ---
#LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
#LLM_BACKUP_MODEL=deepseek-chat
#LLM_BACKUP_API_KEY=sk-...

# --- Timeout & thử lại ---
#LLM_TIMEOUT=300
#LLM_MAX_RETRIES=3
#LLM_RETRY_BASE_DELAY=2
#LLM_RETRY_MAX_DELAY=60
#LLM_RETRY_BUFFER_SECONDS=2
#LLM_RETRY_JITTER=0.2
#LLM_RETRY_CONCURRENCY_WAIT=10
#LLM_RETRY_SLOT_REBUILD_AFTER=3
#LLM_PROVIDER_CONCURRENCY=1
#LLM_PROVIDER_CONCURRENCY_MAX=0

# --- Chia đoạn & song song ---
#CHUNK_MAX_TOKENS=700
#CHUNK_OVERLAP_TOKENS=80
#MAX_CONCURRENCY=1

# --- Ngân sách output ---
#TRANSLATOR_MAX_TOKENS=16384
#TRANSLATOR_REASONING=auto
#VERIFIER_MAX_TOKENS=4096
#VERIFIER_REASONING=auto

# --- Chất lượng ---
#CRITIC_THRESHOLD=7
#REFINE_ROUNDS=2
#REFINE_MIN_SCORE=7
#RB_TOP_K=4
#ADAPTIVE_QUALITY=1
#FAST_PATH_MAX_COMPLEXITY=0.65
#FAST_PATH_MIN_SCORE=9
#FAST_PATH_SKIP_LLM_VERIFY=0
#CONSISTENCY_CHECK=1
#CONSISTENCY_MAX_PATCHES=5

# --- Chờ & chạy lại một chunk ---
#CHUNK_RETRY_BASE_DELAY=5
#CHUNK_RETRY_MAX_DELAY=120
#CHUNK_MAX_ATTEMPTS=6
#CHUNK_STOP_AFTER_FAILURES=3
#PREFLIGHT=true
#VERIFY_UNAVAILABLE_RETRIES=2
#VERIFY_RETRY_DELAY=5
#COMPLETION_ROUNDS=2
#COMPLETION_RETRY_DELAY=20
#COMPLETION_DEADLINE_SECONDS=900

# --- Thư mục & đầu ra ---
#REASONING_BANK_PATH=./data/reasoning_bank
#SKILLS_DIR=./skills
#SKILL_APPLY=1
#SKILL_MIN_SAMPLES=20
#SKILL_MIN_GAIN=0.2
#LOGS_DIR=./logs
#LOG_JSONL=1
#CHECKPOINT_DIR=./data/checkpoints
#RESUME=0
#OUTPUT_FORMAT=md
#PDF_FONT_PATH=
#PARTIAL_OUTPUT=1
#INGEST_AI_REVIEW=0
#INGEST_AI_REVIEW_MAX_BLOCKS=20
#INGEST_AI_REVIEW_MAX_CHARS=2000

# --- Cache & log ---
#PROMPT_CACHE=auto
#LLM_MOCK=0
#LLM_VERBOSE=0
#LLM_VERBOSE_RESILIENCE=0
