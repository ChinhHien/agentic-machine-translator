# Bản mẫu cấu hình polyglot-lc. Sao chép thành .env rồi điền giá trị.
# .env đã nằm trong .gitignore — KHÔNG commit khoá thật.
#
# Phần BẮT BUỘC ở trên: bốn nhóm endpoint.
# Phần TÙY CHỌN ở dưới: mọi biến tinh chỉnh đã bị comment sẵn kèm giá trị
# mặc định của mã. Bỏ comment dòng nào là đổi đúng biến đó; không bỏ comment
# thì mã dùng mặc định, nên mặc định thay đổi trong mã vẫn tới được bạn.
#
# Giải thích từng biến và khi nào nên đổi: docs/configuration.md

# --- Planner ------------------------------------------------------------------
# Chạy MỘT LẦN ở đầu pipeline: chiến lược, thuật ngữ, ghi chú từng phần.
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini
PLANNER_API_KEY=sk-...

# --- Nhóm đọc-nguồn (Translator · Critic · Refiner) ---------------------------
# Dùng CHUNG một provider/model để bộ nhớ đệm tiền tố của provider phục vụ
# được cả ba. Giá trị riêng TRANSLATOR_*/CRITIC_*/REFINER_* vẫn thắng nếu đặt.
SOURCE_GROUP_BASE_URL=https://api.openai.com/v1
SOURCE_GROUP_MODEL=gpt-4o
SOURCE_GROUP_API_KEY=sk-...

# --- Verifier -----------------------------------------------------------------
# Độc lập với nhóm trên: chỉ đọc bản dịch cuối và các tiêu chí.
VERIFIER_BASE_URL=https://api.openai.com/v1
VERIFIER_MODEL=gpt-4o-mini
VERIFIER_API_KEY=sk-...

# --- Embedding (Reasoning Bank) -----------------------------------------------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-...

# ==============================================================================
# TÙY CHỌN — mỗi dòng là một biến kèm mặc định của mã. Bỏ comment để đổi.
# ==============================================================================

# --- Thư mục & đầu ra ---------------------------------------------------------
#REASONING_BANK_PATH=./data/reasoning_bank
#SKILLS_DIR=./skills
# SkillOpt: tắt skill để chạy đối chứng trên cùng tài liệu.
#SKILL_APPLY=1
# Số chunk tối thiểu + mức vượt tối thiểu trước khi promote một version.
#SKILL_MIN_SAMPLES=20
#SKILL_MIN_GAIN=0.2
#LOGS_DIR=./logs
#CHECKPOINT_DIR=./data/checkpoints
#OUTPUT_FORMAT=md
#PARTIAL_OUTPUT=0
#RESUME=0
#PDF_FONT_PATH=

# --- Logging / chạy thử -------------------------------------------------------
#LOG_JSONL=1
#LLM_VERBOSE=0
#LLM_VERBOSE_RESILIENCE=0
#LLM_MOCK=0

# --- Chia đoạn & song song ----------------------------------------------------
#CHUNK_MAX_TOKENS=700
#CHUNK_OVERLAP_TOKENS=80
# Số chunk dịch song song. Phải đi kèm LLM_PROVIDER_CONCURRENCY tương ứng:
# tăng mỗi biến này thì mọi worker vẫn xếp hàng trên một slot provider.
#MAX_CONCURRENCY=1

# --- Chất lượng ---------------------------------------------------------------
#CRITIC_THRESHOLD=7.0
#REFINE_ROUNDS=2
#REFINE_MIN_SCORE=7.0
#RB_TOP_K=4
# Ngân sách output của MỘT lần Verifier (mặc định trong mã: 4096). Provider
# reasoning tính cả token suy nghĩ vào trần này, nên chunk khó có thể cần nhiều
# hơn; lần retry xin gấp đôi (không quá 32768) và mức đó được nhớ cho các chunk
# sau. Nếu cả hai lần vẫn bị cắt (model suy nghĩ gần hết trần), Verifier hỏi lại
# bằng verdict tối giản {pass, reasons} thay vì lặp y nguyên câu hỏi.
#VERIFIER_MAX_TOKENS=4096
# auto = để model suy nghĩ như nó muốn; off = gửi hint tắt suy nghĩ cho gateway
# hiểu (100milionseek/DeepSeek: thinking.type=disabled), để trần output dành
# cho câu trả lời. Gateway không hiểu hint này sẽ bỏ qua nó.
#VERIFIER_REASONING=auto
# Ngân sách output cho LẦN HỎI LẠI của Translator sau khi reply bị cắt. Lần hỏi
# đầu KHÔNG đặt trần: để mặc định của endpoint, vốn đã đủ cho model reasoning
# suy nghĩ ~6000 token rồi trả lời ~2600. Chỉ lần hỏi lại mới cần một trần tường
# minh, và nó phải lớn hơn phần ngân sách vừa bị cắt — 4096 cũ nhỏ hơn một nửa
# mức trung vị thật (~9000) nên lần hỏi lại bị cắt tiếp và báo lỗi oan.
# Trần cứng của thang leo là 32768; gateway có thể từ chối max_tokens quá hạn
# của nó, nên hạ giá trị này nếu endpoint của bạn báo lỗi 400.
#TRANSLATOR_MAX_TOKENS=16384

# --- Đường tắt thích ứng ------------------------------------------------------
#ADAPTIVE_QUALITY=1
#FAST_PATH_MAX_COMPLEXITY=0.65
#FAST_PATH_MIN_SCORE=9.0
#FAST_PATH_SKIP_LLM_VERIFY=0

# --- Nhất quán thuật ngữ xuyên chunk ------------------------------------------
#CONSISTENCY_CHECK=1
# Ngân sách vá thực tế = max(giá trị dưới, 30% số chunk lệch); 0 là tắt vá.
#CONSISTENCY_MAX_PATCHES=5

# --- Retry & timeout ----------------------------------------------------------
#LLM_MAX_RETRIES=3
# Trần thời gian một request (giây). Call không stream, nên SDK read-timeout
# thực chất là hạn chót cho TOÀN BỘ quá trình sinh câu trả lời: model reasoning
# nghĩ vài nghìn token rồi mới trả lời có thể mất hàng phút. 45s cũ giết oan
# call khoẻ (median 47s, max 301s trong một lần chạy thật) rồi fallback tốn kém.
#LLM_TIMEOUT=300
#LLM_RETRY_BASE_DELAY=2
#LLM_RETRY_MAX_DELAY=60
#LLM_RETRY_BUFFER_SECONDS=2
#LLM_RETRY_JITTER=0.2
#LLM_PROVIDER_CONCURRENCY=1
#LLM_RETRY_CONCURRENCY_WAIT=10
#LLM_RETRY_SLOT_REBUILD_AFTER=3

# --- Chờ rồi chạy lại một chunk -----------------------------------------------
#CHUNK_RETRY_BASE_DELAY=5
#CHUNK_RETRY_MAX_DELAY=120

# --- Prompt cache -------------------------------------------------------------
# auto|explicit|off (mặc định: auto; xem docs/configuration.md)
#PROMPT_CACHE=auto

# --- Nhiệt độ & timeout theo nhóm/agent ---------------------------------------
#SOURCE_GROUP_TEMPERATURE=0.3
#VERIFIER_TEMPERATURE=0.0
#EMBED_TIMEOUT=300
# Ghi đè theo từng agent: cùng bộ biến, đổi tiền tố sang TRANSLATOR_,
# CRITIC_, REFINER_, PLANNER_, VERIFIER_ (ví dụ CRITIC_MODEL=deepseek-chat).
#TRANSLATOR_BASE_URL=https://api.openai.com/v1
#TRANSLATOR_MODEL=gpt-4o
#TRANSLATOR_API_KEY=sk-...
#TRANSLATOR_TEMPERATURE=0.3
#TRANSLATOR_TIMEOUT=300

# Endpoint dự phòng, chỉ dùng sau khi endpoint chính hết lượt thử lại.
#LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
#LLM_BACKUP_MODEL=deepseek-chat
#LLM_BACKUP_API_KEY=sk-...
