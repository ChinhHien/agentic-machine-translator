[TEMPLATE]
# =============================================================================
# polyglot-lc environment configuration
# Copy to .env and fill values. Every agent can use a DIFFERENT provider
# (OpenAI, DeepSeek, Anthropic via OpenAI-compatible proxy, Ollama, vLLM...).
# =============================================================================

# ----------------------------- Planner agent ---------------------------------
# Planner runs ONCE at the start of the pipeline (doc-level strategy) and is
# independent of the read-source group.
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini
PLANNER_API_KEY=sk-...
PLANNER_TEMPERATURE=0.2

# =============================================================================
# READ-SOURCE GROUP (Hybrid architecture)
# -----------------------------------------------------------------------------
# Translator, Critic and Refiner all re-read the SAME original source chunk and
# cross-reference it with the plan/draft/critique. Keeping them on ONE
# provider/model lets the provider's native prompt/context cache serve the
# shared stable prefix (original text + glossary + strategy).
# Set the group once here; any per-agent TRANSLATOR_*/CRITIC_*/REFINER_* value
# still overrides it. Verifier stays independent.
SOURCE_GROUP_BASE_URL=https://api.openai.com/v1
SOURCE_GROUP_MODEL=gpt-4o
SOURCE_GROUP_API_KEY=sk-...
SOURCE_GROUP_TEMPERATURE=0.3

# ---------------------------- Translator agent -------------------------------
# Optional per-agent override of the read-source group.
#TRANSLATOR_BASE_URL=https://api.openai.com/v1
#TRANSLATOR_MODEL=gpt-4o
#TRANSLATOR_API_KEY=sk-...
#TRANSLATOR_TEMPERATURE=0.3

# ------------------------------ Critic agent ---------------------------------
#CRITIC_BASE_URL=https://api.deepseek.com/v1
#CRITIC_MODEL=deepseek-chat
#CRITIC_API_KEY=sk-...
#CRITIC_TEMPERATURE=0.1

# ------------------------------ Refiner agent --------------------------------
#REFINER_BASE_URL=http://localhost:11434/v1
#REFINER_MODEL=qwen2.5:14b
#REFINER_API_KEY=ollama
#REFINER_TEMPERATURE=0.4

# ------------------------------ Verifier agent -------------------------------
# Independent group: reads final translation + criteria only.
VERIFIER_BASE_URL=https://openai-proxy.anthropic.com/v1
VERIFIER_MODEL=claude-3-5-sonnet-20241022
VERIFIER_API_KEY=sk-ant-...
VERIFIER_TEMPERATURE=0.0

# --------------------------- Embedding (Reasoning Bank) ----------------------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-...

# ----------------------------- General settings ------------------------------
REASONING_BANK_PATH=./data/reasoning_bank
SKILLS_DIR=./skills
LOGS_DIR=./logs
LOG_JSONL=1
LLM_MOCK=0

# ------------------- LLM resilience (infrastructure failures) ----------------
# Bounded retries for transport/provider failures only (429, 408, timeout,
# 500/502/503/504, connection errors). Semantic failures (Verifier FAIL) use a
# separate, bounded retranslate path and never mix with these.
# LLM_MAX_RETRIES is the infrastructure retry cap (a.k.a. MAX_INFRA_RETRIES).
LLM_MAX_RETRIES=3
# Exponential backoff (used when the provider gives no retry hint): 2s, 4s, 8s...
LLM_RETRY_BASE_DELAY=2
LLM_RETRY_MAX_DELAY=60
# Added on top of a provider hint ("try again in 47.4s" -> wait 47.4s + 2s).
LLM_RETRY_BUFFER_SECONDS=2
# Bounded jitter fraction in [0,1] applied to exponential backoff (avoids
# thundering-herd retries); provider Retry-After hints are used as-is.
LLM_RETRY_JITTER=0.2

# ------------------------- Backup endpoints (fallback) -----------------------
# Optional per-agent backup endpoint. Used only after retries are exhausted on
# the primary (rate limit, timeout, connection error). Requires BOTH vars.
# TRANSLATOR_BACKUP_BASE_URL=https://api.deepseek.com/v1
# TRANSLATOR_BACKUP_MODEL=deepseek-chat
# TRANSLATOR_BACKUP_API_KEY=sk-...

# Translation defaults
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
CRITIC_THRESHOLD=7.0
REFINE_ROUNDS=2
RB_TOP_K=4

# Bounded concurrency across independent chunks (each chunk keeps its internal
# Translate -> Critic -> Refiner -> Verify order). Conservative default of 2.
# Planner/summary/assemble stay sequential. Set 1 for fully sequential runs.
MAX_CONCURRENCY=2

# Adaptive refiner gate: a draft scoring >= this skips the Refiner and goes
# straight to the Verifier. Defaults to CRITIC_THRESHOLD (no behaviour change);
# raise it to skip refiners in the "acceptable but below threshold" band.
REFINE_MIN_SCORE=7.0

# ------------------------- Prompt / context caching --------------------------
# auto (default): order requests stable-prefix-first so the provider can cache
#   the shared source context automatically; read cache-usage metrics when the
#   API reports them (OpenAI prompt_tokens_details.cached_tokens, DeepSeek
#   prompt_cache_hit_tokens, Anthropic cache_read_input_tokens).
# explicit: additionally send an Anthropic-style cache_control breakpoint after
#   the stable prefix (for gateways that require explicit cache markers).
# off: send no markers (usage metrics are still recorded when provided).
PROMPT_CACHE=auto

# When 0 (default) the summary tree skips the per-chunk Planner LLM calls
# (those per-chunk summaries are unused downstream). Set to 1 to restore them.
SUMMARY_TREE_CHUNK_SUMMARIES=0
